{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(apps/**)",
      "Edit(test/**)",
      "Edit(docs/**)",
      "Bash(yarn typecheck)",
      "Bash(yarn lint)",
      "Bash(yarn lint:*)",
      "Bash(yarn test)",
      "Bash(yarn test:*)",
      "Bash(yarn verify)",
      "Bash(yarn build)",
      "Bash(yarn db:generate)",
      "Bash(yarn workspace @eztask/api typecheck)",
      "Bash(yarn workspace @eztask/api test:*)",
      "Bash(yarn workspace @eztask/fake-pos typecheck)",
      "Bash(yarn workspace @eztask/fake-pos test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose build:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(yarn add:*)",
      "Bash(yarn remove:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose stop:*)",
      "Bash(docker compose kill:*)",
      "Edit(.claude/**)",
      "Edit(.husky/**)",
      "Edit(.github/**)",
      "Edit(CLAUDE.md)",
      "Edit(package.json)",
      "Edit(eslint.config.mjs)",
      "Edit(tsconfig.base.json)",
      "Edit(docker-compose*.yml)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(apps/api/drizzle/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(npx drizzle-kit push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-commands.mjs\"" }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migrations.mjs\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-after-edit.mjs\"", "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-before-stop.mjs\"", "timeout": 300 }
        ]
      }
    ]
  }
}
