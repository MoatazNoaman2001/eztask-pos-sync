# Environment variable template. Keys only, no values.
# `yarn setup` (also run by `yarn install`) turns it into a git-ignored .env with local values.
# Meaning of each key: docs/configuration.md

# ---- postgres (docker compose) ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Port on your machine; pick a free one if a local Postgres already uses 5432.
POSTGRES_HOST_PORT=

# ---- load balancer (docker compose) ----
# Port on your machine for the API behind the load balancer.
LB_HOST_PORT=

# ---- api ----
PORT=
INSTANCE_ID=
DATABASE_URL=
POS_BASE_URL=
POS_HTTP_TIMEOUT_MS=
SYNC_LEASE_MS=
SYNC_WORKER_ENABLED=
SYNC_POLL_INTERVAL_MS=
SYNC_BATCH_SIZE=
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW_MS=

# ---- fake-pos ----
FAKE_POS_PORT=
FAIL_RATE=
TIMEOUT_AFTER_CREATE_RATE=
SLOW_RATE=

# ---- chaos test (docker-compose.chaos.yml) ----
CHAOS_FAIL_RATE=
CHAOS_TIMEOUT_AFTER_CREATE_RATE=
CHAOS_SLOW_RATE=
