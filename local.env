# Environment variable template. Keys only, no values.
# Copy to .env (git-ignored) and fill in: docker compose and the yarn scripts read it.
# Meaning of each key: docs/configuration.md

# ---- postgres (docker compose) ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Port on your machine; pick a free one if a local Postgres already uses 5432.
POSTGRES_HOST_PORT=

# ---- api ----
PORT=
INSTANCE_ID=
DATABASE_URL=
POS_BASE_URL=
POS_HTTP_TIMEOUT_MS=
SYNC_LEASE_MS=
SYNC_POLL_INTERVAL_MS=
SYNC_BATCH_SIZE=
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW_MS=

# ---- fake-pos ----
FAKE_POS_PORT=
FAIL_RATE=
TIMEOUT_AFTER_CREATE_RATE=
SLOW_RATE=
