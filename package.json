{
  "name": "eztask-pos-sync",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "yarn workspaces run build",
    "typecheck": "yarn workspaces run typecheck",
    "lint": "eslint .",
    "test": "yarn workspaces run test",
    "verify": "yarn typecheck && yarn lint && yarn test",
    "db:generate": "yarn workspace @eztask/api db:generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0"
  }
}
